+    void IopMemory::transferSpuDma(uint32_t channel, uint32_t coreOffset, uint32_t control, uint64_t words)
+    {
+        // MADR is a byte address in IOP RAM. TSA is a halfword address in sound RAM.
+        const uint32_t iopAddress = readHardware32(channel - 8u) & 0x00FFFFFCu;
+        const uint32_t tsa = readHardware32(kSpuTransferAddress + coreOffset);
+        const uint32_t soundAddress = ((tsa << 16u) | (tsa >> 16u)) & kSpuRamMask;
+        if (iopAddress >= RamSize || words > (RamSize - iopAddress) / sizeof(uint32_t))
+            return;
+
+        const size_t halfwords = static_cast<size_t>(words) * 2u;
+        for (size_t index = 0; index < halfwords; ++index)
+        {
+            uint8_t *iop = m_ram.data() + iopAddress + index * sizeof(uint16_t);
+            uint16_t &sound = m_spuRam[(soundAddress + index) & kSpuRamMask];
+            if (control & 1u)
+                std::memcpy(&sound, iop, sizeof(sound));
+            else
+                std::memcpy(iop, &sound, sizeof(sound));
+        }
+        if ((control & 1u) == 0u)
+            markOwned(iopAddress, halfwords * sizeof(uint16_t));
+        m_hardware[channel - 8u] = iopAddress + halfwords * sizeof(uint16_t);
+    }
