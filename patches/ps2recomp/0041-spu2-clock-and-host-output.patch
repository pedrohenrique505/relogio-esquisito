+void PS2IopHostAdapter::submitSpuAudio(std::span<const int16_t> samples) noexcept
+{
+#if defined(PLATFORM_VITA)
+    (void)samples;
+#else
+    if (!IsAudioDeviceReady())
+        return;
+
+    const int frames = static_cast<int>(samples.size() / 2);
+    if (!m_spuStream.buffer)
+    {
+        if (std::none_of(samples.begin(), samples.end(), [](int16_t sample) { return sample != 0; }))
+            return;
+        SetAudioStreamBufferSizeDefault(frames);
+        m_spuStream = LoadAudioStream(48000, 16, 2);
+        SetAudioStreamBufferSizeDefault(0);
+        if (!m_spuStream.buffer)
+            return;
+        PlayAudioStream(m_spuStream);
+    }
+    if (IsAudioStreamProcessed(m_spuStream))
+        UpdateAudioStream(m_spuStream, samples.data(), frames);
+#endif
+}
