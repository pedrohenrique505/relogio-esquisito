+    bool testSpuDmaVoicePlayback()
+    {
+        IopMemory memory;
+        constexpr uint32_t base = IopMemory::Spu2Base;
+        constexpr uint32_t sampleAddress = 0x2800u;
+        // One final ADPCM block with a zero predictor and 28 identical samples.
+        constexpr std::array<uint32_t, 4> block{
+            0x11110100u, 0x11111111u, 0x11111111u, 0x11111111u
+        };
+        if (!expect(memory.writeRam(0x1000u, block.data(), sizeof(block)), "could not seed SPU DMA source"))
+            return false;
+        memory.write32(base + 0x1A8u, sampleAddress << 16u);
+        memory.write32(0x1F8010C0u, 0x1000u);
+        memory.write32(0x1F8010C4u, 0x00010004u);
+        memory.write32(0x1F8010C8u, 0x01000201u);
+        if (!expect(memory.takeDmaStart().has_value(), "SPU DMA did not schedule completion"))
+            return false;
+
+        memory.write32(base + 0x1C0u, sampleAddress << 16u);
+        memory.write16(base, 0x2000u);
+        memory.write16(base + 2u, 0x1000u);
+        memory.write16(base + 4u, 0x1000u);
+        memory.write16(base + 0x760u, 0x4000u);
+        memory.write16(base + 0x762u, 0x4000u);
+        memory.write32(base + 0x19Cu, sampleAddress << 16u);
+        memory.write16(base + 0x19Au, 0x8040u);
+        memory.write16(base + 0x1A0u, 1u);
+
+        std::array<int16_t, 2> output{};
+        for (int i = 0; i < 28; ++i)
+        {
+            memory.mixSpuFrame(output);
+            if (!expect(output[0] == 1024 && output[1] == 512, "SPU decoded or mixed the DMA block incorrectly") ||
+                !expect(memory.takeSpuInterrupt() == (i == 0), "SPU address IRQ did not latch once"))
+                return false;
+        }
+        memory.mixSpuFrame(output);
+        return expect(output[0] == 0 && output[1] == 0, "SPU voice played past the end flag") &&
+               expect((memory.read16(base + 0x340u) & 1u) == 1u, "SPU voice did not set ENDX");
+    }
