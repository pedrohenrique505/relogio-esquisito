+    void IopMemory::writeSpuRegister(uint32_t address, uint16_t value)
+    {
+        const uint32_t aligned = address & ~3u;
+        const uint32_t shift = (address & 2u) * 8u;
+        m_hardware[aligned] = (readHardware32(aligned) & ~(0xFFFFu << shift)) |
+                              (static_cast<uint32_t>(value) << shift);
+        const uint32_t core = (address >> 10u) & 1u;
+        const uint32_t coreOffset = core * 0x400u;
+        const uint32_t reg = address & 0x3FFu;
+        if (reg == 0x19Au && (value & 0x40u) == 0u)
+            m_hardware[Spu2Base + 0x7C0u] &= ~(1u << (18u + core));
+        if (reg == 0x1ACu)
+        {
+            // Manual transfer writes one halfword and advances the transfer address.
+            const uint32_t tsa = kSpuTransferAddress + coreOffset;
+            const uint32_t word = spuAddress(tsa);
+            m_spuRam[word] = value;
+            checkSpuInterrupt(word);
+            const uint32_t next = (word + 1u) & kSpuRamMask;
+            m_hardware[tsa] = (next << 16u) | (next >> 16u);
+        }
+        if (reg >= 0x1C4u && reg < 0x2E0u && (reg - 0x1C4u) % 12u < 4u)
+        {
+            // Streaming drivers can redirect an active voice at the next loop.
+            const size_t index = (reg - 0x1C4u) / 12u;
+            m_spuVoices[core][index].loop = spuAddress(aligned) & ~7u;
+        }
+        if (reg < 0x1A0u || reg > 0x1A6u || value == 0u)
+            return;
+
+        const size_t first = (reg & 2u) ? 16u : 0u;
+        for (size_t index = first; index < std::min(first + 16u, size_t{24}); ++index)
+        {
+            if ((value & (1u << (index - first))) == 0u)
+                continue;
+            auto &voice = m_spuVoices[core][index];
+            if ((reg & 4u) != 0u)
+            {
+                finishSpuVoice(coreOffset, index);
+                continue;
+            }
+            voice = {};
+            voice.address = spuAddress(Spu2Base + coreOffset + 0x1C0u + 12u * index) & ~7u;
+            voice.loop = spuAddress(Spu2Base + coreOffset + 0x1C4u + 12u * index) & ~7u;
+            voice.active = true;
+            m_hardware[Spu2Base + coreOffset + 0x340u] &= ~(1u << index);
+        }
+    }
+
+    void IopMemory::checkSpuInterrupt(uint32_t wordAddress)
+    {
+        for (uint32_t core = 0; core < 2; ++core)
+        {
+            const uint32_t base = Spu2Base + core * 0x400u;
+            const uint32_t flag = 1u << (18u + core);
+            if ((readHardware32(base + 0x198u) & (0x40u << 16u)) != 0u &&
+                (readHardware32(Spu2Base + 0x7C0u) & flag) == 0u &&
+                spuAddress(base + 0x19Cu) == wordAddress)
+            {
+                m_hardware[Spu2Base + 0x7C0u] |= flag;
+                m_spuInterrupt = true;
+            }
+        }
+    }
+
+    bool IopMemory::takeSpuInterrupt() noexcept
+    {
+        const bool pending = m_spuInterrupt;
+        m_spuInterrupt = false;
+        return pending;
+    }
+
+    void IopMemory::decodeSpuBlock(SpuVoice &voice)
+    {
+        constexpr int filter[][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+        const uint16_t header = m_spuRam[voice.address];
+        const uint32_t shift = (header & 15u) > 12u ? 9u : header & 15u;
+        const uint32_t predictor = (header >> 4u) & 7u;
+        voice.flags = static_cast<uint8_t>(header >> 8u);
+        if ((voice.flags & 4u) != 0u)
+            voice.loop = voice.address;
+        for (uint32_t word = 0; word < 8; ++word)
+            checkSpuInterrupt((voice.address + word) & kSpuRamMask);
+
+        for (size_t index = 0; index < voice.samples.size(); ++index)
+        {
+            const uint16_t data = m_spuRam[(voice.address + 1u + index / 4u) & kSpuRamMask];
+            const int nibble = (data >> ((index % 4u) * 4u)) & 15u;
+            const int raw = nibble < 8 ? nibble : nibble - 16;
+            const auto &coefficients = filter[predictor < 5u ? predictor : 0u];
+            const int predicted = (voice.history * coefficients[0] +
+                                   voice.older * coefficients[1] + 32) >> 6;
+            const int decoded = std::clamp(raw * (1 << (12u - shift)) + predicted, -32768, 32767);
+            voice.older = voice.history;
+            voice.history = decoded;
+            voice.samples[index] = static_cast<int16_t>(decoded);
+        }
+        voice.sample = 0;
+        voice.address = (voice.address + 8u) & kSpuRamMask;
+    }
+
+    void IopMemory::finishSpuVoice(uint32_t coreOffset, size_t index)
+    {
+        m_spuVoices[coreOffset / 0x400u][index].active = false;
+        m_hardware[Spu2Base + coreOffset + 0x340u] |= 1u << index;
+    }
+
+    void IopMemory::mixSpuFrame(std::span<int16_t, 2> output)
+    {
+        int32_t mix[2]{};
+        for (uint32_t core = 0; core < 2; ++core)
+        {
+            const uint32_t offset = core * 0x400u;
+            const uint32_t base = Spu2Base + offset;
+            for (size_t index = 0; index < m_spuVoices[core].size(); ++index)
+            {
+                auto &voice = m_spuVoices[core][index];
+                if (!voice.active)
+                    continue;
+                while (voice.sample >= voice.samples.size() && voice.active)
+                {
+                    const size_t overshoot = voice.sample - voice.samples.size();
+                    if ((voice.flags & 1u) != 0u)
+                    {
+                        if ((voice.flags & 2u) == 0u)
+                        {
+                            finishSpuVoice(offset, index);
+                            break;
+                        }
+                        m_hardware[base + 0x340u] |= 1u << index;
+                        voice.address = voice.loop;
+                    }
+                    decodeSpuBlock(voice);
+                    voice.sample += overshoot;
+                }
+                if (!voice.active)
+                    continue;
+
+                const int32_t sample = voice.samples[voice.sample];
+                const uint32_t volume = readHardware32(base + 16u * index);
+                const uint32_t master = readHardware32(Spu2Base + 0x760u + 40u * core);
+                for (uint32_t channel = 0; channel < 2; ++channel)
+                {
+                    const uint16_t level = (volume >> (16u * channel)) & 0x7FFFu;
+                    const int32_t gain = (static_cast<int32_t>(level) ^ 0x4000) - 0x4000;
+                    const auto masterGain = static_cast<int16_t>(master >> (16u * channel));
+                    mix[channel] += ((sample * gain / 0x4000) * masterGain) / 0x8000;
+                }
+                voice.phase += readHardware32(base + 16u * index + 4u) & 0x3FFFu;
+                voice.sample += voice.phase >> 12u;
+                voice.phase &= 0xFFFu;
+            }
+        }
+        for (size_t channel = 0; channel < output.size(); ++channel)
+            output[channel] = static_cast<int16_t>(std::clamp(mix[channel], -32768, 32767));
+    }
