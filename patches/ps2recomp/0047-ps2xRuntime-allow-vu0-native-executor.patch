+
+    inline Vu1ActiveMasks &activeMasksFor(const VU1Interpreter *self) noexcept
+    {
+        // Fast non-TLS lookup: typically only 1-2 VU interpreters exist on GameThread.
+        struct Slot { const VU1Interpreter *key = nullptr; Vu1ActiveMasks masks{}; };
+        static Slot s_slots[4]{};
+        if (s_slots[0].key == self)
+            return s_slots[0].masks;
+        if (s_slots[1].key == self)
+            return s_slots[1].masks;
+        for (size_t i = 2; i < 4; ++i)
+        {
+            if (s_slots[i].key == self)
+                return s_slots[i].masks;
+        }
+        for (size_t i = 0; i < 4; ++i)
+        {
+            if (s_slots[i].key == nullptr)
+            {
+                s_slots[i].key = self;
+                s_slots[i].masks = {};
+                return s_slots[i].masks;
+            }
+        }
+        s_slots[3].key = self;
+        s_slots[3].masks = {};
+        return s_slots[3].masks;
+    }
