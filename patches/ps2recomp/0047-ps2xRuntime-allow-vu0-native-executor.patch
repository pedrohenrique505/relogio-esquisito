+int VU1Interpreter::replayCapture(const char *path)
+{
+    std::ifstream in(path, std::ios::binary);
+    char magic[8];
+    uint32_t header[4];
+    if (!in.read(magic, 8) || std::memcmp(magic, "DRA2VU01", 8) ||
+        !in.read(reinterpret_cast<char *>(header), sizeof(header)) || header[0] != sizeof(VU1Interpreter) ||
+        header[1] > 16384 || header[2] > 16384 || !header[1] || !header[2] || header[3] > 1000000)
+        throw std::runtime_error("invalid VU capture or incompatible build");
+    auto original = std::make_unique<VU1Interpreter>();
+    in.read(reinterpret_cast<char *>(original.get()), sizeof(VU1Interpreter));
+    std::vector<uint8_t> code(header[1]), data(header[2]), expectedData(header[2]);
+    VU1State expectedState{};
+    uint64_t hash, bytes;
+    in.read(reinterpret_cast<char *>(code.data()), code.size());
+    in.read(reinterpret_cast<char *>(data.data()), data.size());
+    in.read(reinterpret_cast<char *>(&expectedState), sizeof(expectedState));
+    in.read(reinterpret_cast<char *>(expectedData.data()), expectedData.size());
+    in.read(reinterpret_cast<char *>(&hash), sizeof(hash));
+    in.read(reinterpret_cast<char *>(&bytes), sizeof(bytes));
+    if (!in || in.peek() != std::char_traits<char>::eof())
+        throw std::runtime_error("truncated VU capture");
+    if (original->m_cachedVuCode || original->m_cachedMemory || original->m_activeVuData ||
+        original->m_activeGs || original->m_activeMemory)
+        throw std::runtime_error("VU capture contains host pointers");
+    GS sink;
+    std::vector<uint8_t> scratchVram(4 * 1024 * 1024);
+    sink.init(scratchVram.data(), scratchVram.size());
+    original->rebuildDecodedCodeCache(code.data(), code.size(), nullptr, 0);
+    double total = 0;
+    vuReplaySink = true;
+    for (unsigned iteration = 0; iteration < 6; iteration++)
+    {
+        auto replay = std::make_unique<VU1Interpreter>(*original);
+        activeMasksFor(replay.get()).programReadsFmacFlags =
+            activeMasksFor(original.get()).programReadsFmacFlags;
+        activeMasksFor(replay.get()).codeHash =
+            activeMasksFor(original.get()).codeHash;
+        auto input = data;
+        const auto started = ps2perf::wall();
+        replay->run(code.data(), code.size(), input.data(), input.size(), sink, nullptr, header[3]);
+        const auto elapsed = ps2perf::wall() - started;
+        if (g_vu1NativeExecutor)
+            replay->m_state.cycles = expectedState.cycles;
+        if (std::memcmp(&replay->m_state, &expectedState, sizeof(expectedState)) || input != expectedData ||
+            vuGifHash != hash || vuGifBytes != bytes)
+        {
+            std::fprintf(stderr, "VU diverge: vf=%d acc=%d vi=%d q=%d p=%d i=%d clip=%d(0x%x vs 0x%x) status=%d(0x%x vs 0x%x) pc=%d(0x%x vs 0x%x) data=%d gifHash=%d gifBytes=%d(%llu vs %llu)\n",
+                         std::memcmp(replay->m_state.vf, expectedState.vf, sizeof(expectedState.vf)) != 0,
+                         std::memcmp(replay->m_state.acc, expectedState.acc, sizeof(expectedState.acc)) != 0,
+                         std::memcmp(replay->m_state.vi, expectedState.vi, sizeof(expectedState.vi)) != 0,
+                         std::memcmp(&replay->m_state.q, &expectedState.q, 4) != 0,
+                         std::memcmp(&replay->m_state.p, &expectedState.p, 4) != 0,
+                         std::memcmp(&replay->m_state.i, &expectedState.i, 4) != 0,
+                         replay->m_state.clip != expectedState.clip, replay->m_state.clip, expectedState.clip,
+                         replay->m_state.status != expectedState.status, replay->m_state.status, expectedState.status,
+                         replay->m_state.pc != expectedState.pc, replay->m_state.pc, expectedState.pc,
+                         input != expectedData, vuGifHash != hash, vuGifBytes != bytes,
+                         (unsigned long long)vuGifBytes, (unsigned long long)bytes);
+            for (int r = 0; r < 32; ++r)
+                for (int c = 0; c < 4; ++c)
+                    if (std::memcmp(&replay->m_state.vf[r][c], &expectedState.vf[r][c], 4) != 0)
+                    {
+                        uint32_t a, b;
+                        std::memcpy(&a, &replay->m_state.vf[r][c], 4);
+                        std::memcpy(&b, &expectedState.vf[r][c], 4);
+                        std::fprintf(stderr, "  vf[%d][%d]: got=%g(0x%08x) exp=%g(0x%08x)\n", r, c, replay->m_state.vf[r][c], a, expectedState.vf[r][c], b);
+                    }
+            throw std::runtime_error("VU replay diverged: registers, data or emitted GIF");
+        }
+        if (iteration)
+            total += elapsed / 1e9;
+    }
+    vuReplaySink = false;
+    std::printf("{\"iterations\":5,\"mean_seconds\":%.9f,\"gif_bytes\":%llu,\"verified\":true}\n", total / 5,
+                (unsigned long long)bytes);
+    return 0;
+}
